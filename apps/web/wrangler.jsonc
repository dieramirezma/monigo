{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "monigo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "monigo.dieramirezma.dev",
			"custom_domain": true
		}
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://monigo.dieramirezma.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "monigo-db",
			"database_id": "e9e02ff7-6704-4356-b9db-230181b9057e",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "monigo-media"
		}
	]
}