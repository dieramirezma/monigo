{
  "name": "web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply monigo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply monigo-db --remote",
    "predev": "node scripts/sync-media.mjs",
    "prebuild": "node scripts/sync-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@monigo/content": "workspace:*",
    "@monigo/db": "workspace:*",
    "@monigo/ui": "workspace:*",
    "@opennextjs/cloudflare": "1.20.18",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "4.166.0"
  },
  "packageManager": "pnpm@10.10.0"
}
